# LibreChat Configuration Template
# Copy this file to .env and configure with your values

# Server Configuration
HOST=0.0.0.0
PORT=3080
NODE_ENV=production

# MongoDB Configuration (provided by Azure deployment)
MONGO_URI=

# Redis Configuration (provided by Azure deployment)
REDIS_URI=

# JWT Secrets (provided by Azure deployment)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Credentials Encryption (provided by Azure deployment)
CREDS_KEY=
CREDS_IV=

# Azure Storage Configuration (provided by Azure deployment)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=uploads

# Meilisearch Configuration
MEILI_HOST=http://meilisearch:7700
MEILI_NO_ANALYTICS=true

# OpenAI Configuration (optional - configure after deployment)
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-3.5-turbo,gpt-4

# Azure OpenAI Configuration (optional)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=

# Anthropic Configuration (optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-3-opus-20240229,claude-3-sonnet-20240229

# Google Configuration (optional)
# GOOGLE_KEY=
# GOOGLE_MODELS=gemini-pro

# Additional Settings
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

# Session Configuration
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=1000 * 60 * 60 * 24 * 7

# File Upload Configuration
FILE_UPLOAD_SIZE_LIMIT=20971520
FILE_UPLOAD_IP_MAX=100
FILE_UPLOAD_IP_WINDOW=60000
FILE_UPLOAD_USER_MAX=50
FILE_UPLOAD_USER_WINDOW=60000

# Logging
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
